# Watches kernel link state changes (netlink) and regenerates the multi-WAN
# routing when an interface used by a gateway changes its link state.
#
# NetworkManager does not emit dispatcher events for the carrier changes of
# bond, bridge and VLAN interfaces (it ignores the carrier on controller
# devices), so their routing would only be regenerated by the periodic WAN
# failover checker, up to a minute later. On a link change of those
# interfaces this daemon regenerates the routing and re-runs the failover
# checker, so a reconnected WAN is back in the multipath default route (and
# its gateway re-enabled) immediately. Physical interfaces are handled by
# NetworkManager's dispatcher hook and are ignored here.

use strict;
use warnings;

use EBox;
use EBox::Config;
use EBox::Global;
use EBox::Sudo;
use IO::Select;

use TryCatch;

use constant CHECKER => EBox::Config::scripts('network') . 'failover-checker';

# The daemon is started from the network module configuration, both on boot
# and on save. Ignore the link events raised by that configuration for a
# while: the routing is regenerated there anyway.
use constant STARTUP_GRACE => 10;

EBox::init();

open(my $monitor, '-|', '/sbin/ip monitor link') or exit 1;

my $select = IO::Select->new($monitor);
my $graceUntil = time() + STARTUP_GRACE;

while (1) {
    my @ready = $select->can_read();
    my %regenIfaces = ();

    # Drain the burst of events generated by a link change, waiting for the
    # link to settle before regenerating the routing.
    while (@ready) {
        foreach my $fh (@ready) {
            my $line = <$fh>;
            # 'ip monitor' died: exit so the service manager restarts us
            exit 1 unless defined $line;
            next unless ($line =~ /^\d+:\s+([^:@]+)/);
            my $iface = $1;
            try {
                $regenIfaces{$iface} = 1 if _ifaceNeedsRegen($iface);
            } catch ($e) {
                EBox::warn("Cannot check interface $iface after a link change: $e");
            };
        }
        @ready = $select->can_read(2);
    }

    _regenRouting([keys %regenIfaces])
        if (%regenIfaces and (time() >= $graceUntil));
}

# Method: _ifaceNeedsRegen
#
#   Returns whether a link change in the given interface requires regenerating
#   the routing. Only controller and virtual interfaces are handled:
#   NetworkManager reports the link events of physical interfaces (its
#   dispatcher hook regenerates the routing for them), but it does not report
#   the carrier changes of bonds, bridges and VLANs.
#
sub _ifaceNeedsRegen
{
    my ($iface) = @_;

    my $network = EBox::Global->getInstance(1)->modInstance('network');
    return 0 unless ($network->ifaceIsBond($iface) or
                     $network->ifaceIsBridge($iface) or
                     $network->vifaceExists($iface));

    foreach my $gw (@{$network->model('GatewayTable')->allGateways()}) {
        my $gwIface = $gw->{'interface'};
        next unless $network->ifaceExists($gwIface);

        # the interface itself or a VLAN on top of it
        return 1 if (($gwIface eq $iface) or ($gwIface =~ /^\Q$iface\E\./));

        # the bridge of a bridged gateway
        my $bridge = $network->ifaceBridge($gwIface);
        return 1 if (defined($bridge) and ("br$bridge" eq $iface));
    }

    return 0;
}

# Method: _regenRouting
#
#   Regenerates the multi-WAN routing for the given interfaces and, only when
#   any of them is tested by the WAN failover, re-runs the failover checker
#
sub _regenRouting
{
    my ($ifaces) = @_;

    # With pending changes neither the regeneration nor the checker do
    # anything, so there is no point in running them.
    return if EBox::Global->getInstance()->modIsChanged('network');

    # A bond or bridge may need a while to get its carrier back (e.g. the
    # bridge STP forward delay) and the link event arrives before it is
    # usable, so the regeneration could skip it: retry (bounded) until every
    # interface used by an enabled gateway is up.
    my $attempts = 8;
    while ($attempts > 0) {
        EBox::debug('Link state changed: regenerating the gateways');
        try {
            EBox::Global->modInstance('network')->regenGatewaysOnEvent();
        } catch ($e) {
            # Do not die on a transient failure: the next link event or the
            # periodic failover check regenerate the routing again.
            EBox::warn("Could not regenerate the gateways after a link change: $e");
            last;
        };

        last unless _someGatewayIfaceDown();
        sleep 10;
        $attempts--;
    }

    # The probes are only needed when any of the changed interfaces is tested
    # by the failover: without a test rule the regeneration is enough
    return unless _someIfaceHasFailoverRule($ifaces);

    try {
        EBox::Sudo::root(CHECKER);
    } catch ($e) {
        EBox::warn("Could not run the failover check after a link change: $e");
    };
}

# Method: _someIfaceHasFailoverRule
#
#   Returns whether any of the given interfaces is used by a gateway with an
#   enabled WAN failover rule
#
sub _someIfaceHasFailoverRule
{
    my ($ifaces) = @_;

    my $network = EBox::Global->getInstance(1)->modInstance('network');
    my $rules = $network->model('WANFailoverRules');
    my $gateways = $network->model('GatewayTable');
    foreach my $id (@{$rules->enabledRows()}) {
        my $gwIface = $gateways->row($rules->row($id)->valueByName('gateway'))
                                ->valueByName('interface');
        foreach my $iface (@{$ifaces}) {
            return 1 if ($gwIface eq $iface);

            # the bridge of a bridged gateway
            next unless $network->ifaceExists($gwIface);
            my $bridge = $network->ifaceBridge($gwIface);
            return 1 if (defined($bridge) and ("br$bridge" eq $iface));
        }
    }

    return 0;
}

# Method: _someGatewayIfaceDown
#
#   Returns whether any interface used by an enabled gateway is still down
#
sub _someGatewayIfaceDown
{
    my $network = EBox::Global->getInstance(1)->modInstance('network');
    # Only the enabled gateways: the interface of a disabled one (e.g. a WAN
    # the user took out of the pool) is expected to be down
    foreach my $gw (@{$network->gateways()}) {
        my $iface = $gw->{'interface'};
        my $up = 0;
        try {
            $up = EBox::NetWrappers::iface_is_up($iface);
        } catch {
            $up = 0;
        }
        return 1 unless $up;
    }

    return 0;
}
